{
  "version": "0.15.1",
  "scripts": {
    "build": "npx --yes techbook-template-cli build",
    "dev": "npx --yes concurrently \"npx --yes techbook-template-cli dev\" \"npx --yes techbook-template-cli viewer\" \"npx --yes techbook-template-cli browser\"",
    "kdp": "npx --yes techbook-template-cli build -kdp",
    "clean": "npx --yes clear-npx-cache",
    "check": "npx --yes @biomejs/biome check --apply-unsafe ./src"
  },
  "dependencies": {
    "techbook-template-cli": "github:kght6123/techbook-template-cli#v1.0.0-Release"
  },
  "devDependencies": {
    "@biomejs/biome": "1.5.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "volta": {
    "node": "22.22.2"
  }
}
